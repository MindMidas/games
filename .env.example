# Copy to .env in this directory (repo root) before running the server.
#
# GAMES_AUTH_PEPPER must stay stable for existing accounts — changing it invalidates
# stored password hashes and breaks login until users re-register.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
GAMES_AUTH_PEPPER=<generate-with-openssl-rand-hex-32>
DOMAIN=games.example.com

# Optional (unified platform — single server :8080)
# GAMES_ENV=production
# GAMES_ALLOWED_HOSTS=games.example.com
# GAMES_LOG_LEVEL=INFO
# GAMES_SESSION_IDLE_SECONDS=900
# GAMES_RATE_LIMIT=1
# GAMES_RATE_LIMIT_AUTH_PER_MIN=20
# GAMES_RATE_LIMIT_GET_PER_MIN=300
# GAMES_RATE_LIMIT_POST_PER_MIN=180
# GAMES_RATE_LIMIT_INVITE_PER_MIN=10
# GAMES_RATE_LIMIT_SSE_PER_MIN=30
# GAMES_SSE_MAX_CONNECTIONS_PER_IP=6
# GAMES_TRUSTED_PROXY_IPS=127.0.0.1,::1
# GAMES_METRICS_USER_IDS=<your-user-uuid>
# GAMES_CHAT_BATCH_MAX=32
# GAMES_CHAT_FLUSH_MS=20

# Games: python3 src/platform/serve.py --port 8080
# Or from repo root: ./build
